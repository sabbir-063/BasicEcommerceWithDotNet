# Production values should NOT replace development info.txt until deployment is explicitly requested.
# Prefer configuring these directly in Render/Vercel/secret stores rather than keeping a real production file.

APP_ENV=production
APP_NAME=BasicCommerce
APP_CURRENCY=BDT

PROD_FRONTEND_URL=https://YOUR_FRONTEND
PROD_BACKEND_URL=https://YOUR_BACKEND

JWT_SECRET=NEW_PRODUCTION_SECRET
JWT_ISSUER=BasicCommerce.Api
JWT_AUDIENCE=BasicCommerce.Frontend
JWT_ACCESS_TOKEN_MINUTES=60

PROD_ADMIN_NAME=Store Admin
PROD_ADMIN_EMAIL=admin@example.com
PROD_ADMIN_PASSWORD=NEW_PRODUCTION_PASSWORD

NEON_DATABASE_URL_POOLED=PRODUCTION_POOLED_URI
NEON_DATABASE_URL_DIRECT=PRODUCTION_DIRECT_URI

CLOUDINARY_CLOUD_NAME=PRODUCTION_OR_SELECTED_CLOUD_NAME
CLOUDINARY_API_KEY=PRODUCTION_KEY
CLOUDINARY_API_SECRET=PRODUCTION_SECRET
CLOUDINARY_FOLDER=ecommerce-prod
